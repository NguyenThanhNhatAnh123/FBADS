# ===== Agent (tiến trình "agent") — copy thành .env.agent rồi điền =====
# Không đưa file .env.agent vào Git, không gửi qua Telegram.

# --- Kết nối với bridge (localhost) ---
AGENT_PORT=8788
# Chuỗi ngẫu nhiên ≥ 24 ký tự, GIỐNG HỆT BRIDGE_KEY trong .env.bridge
BRIDGE_KEY=
# Chỉ bật khi chạy thử KHÔNG có bridge (Agent tự long polling). Bridge chạy thì để 0.
TG_POLLING=0

# --- Telegram ---
TG_BOT_TOKEN=
# chat_id của chủ shop (nhiều id cách nhau dấu phẩy)
TG_ALLOWED_CHAT_IDS=

# --- Meta (System User trong BM HT 3973332942 bm1, token không hết hạn) ---
META_TOKEN=
META_AD_ACCOUNT=act_25496622559924808
META_PIXEL_ID=625569536048355
META_PAGE_ID=101065259399535
META_API_VERSION=v26.0
# 1 = bật Advantage+ audience (targeting_automation.advantage_audience); 0 = tắt
META_ADVANTAGE_AUDIENCE=1

# --- Tài khoản H3 (dùng làm mặc định, brief không cần nhập lại) ---
ACCOUNT_NAME=H3
ACCOUNT_TIMEZONE=America/Dawson
ACCOUNT_CURRENCY=USD
META_PIXEL_NAME=Native Pixel
META_PAGE_NAME=Native Heritage Store
NAME_PREFIX=Dân

# --- Shopify (First Nations Legacy) ---
SHOPIFY_DOMAIN=xzvd1h-0b.myshopify.com
SHOP_PUBLIC_DOMAIN=firstnationslegacy.com
SHOPIFY_API_VERSION=2026-10
# Cách 1: custom app cũ trong Shopify admin → Admin API access token (shpat_...)
SHOPIFY_TOKEN=
# Cách 2: app tạo trong Dev Dashboard → client credentials (token tự xin lại mỗi 24 giờ)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Google (service account, bật Drive API) ---
# Đường dẫn file JSON của service account (hoặc dán nguyên JSON)
GOOGLE_SA_JSON=C:\ads\secrets\google-sa.json
ROAS_SHEET_ID=
# Tuỳ chọn: thư mục Drive nhận bản sao lưu DB mỗi ngày — PHẢI nằm trong Shared Drive
DRIVE_BACKUP_FOLDER_ID=

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Server-side fallback khi Claude từ chối (chỉ Claude API trực tiếp). 0 để tắt.
CLAUDE_FALLBACKS=1
# Tuỳ chọn: low | medium | high (để trống = mặc định của model)
CLAUDE_EFFORT=

# --- Giới hạn an toàn ---
LIMIT_BUDGET_CONFIRM_USD=300
LIMIT_TOTAL_BUDGET_USD=1500
LIMIT_CAP_MIN_USD=5
LIMIT_CAP_MAX_USD=150
LIMIT_MAX_FILES=10
DUPLICATE_WINDOW_MIN=10
APPROVAL_REMIND_AFTER_H=24
APPROVAL_AUTO_CANCEL_AFTER_H=72

# --- Đường dẫn (tương đối với thư mục dự án) ---
AGENT_DB=data/agent.db
AGENT_TMP_DIR=tmp
AGENT_BACKUP_DIR=data/backups
# Nếu ffmpeg không nằm trong PATH:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
LOG_LEVEL=info
