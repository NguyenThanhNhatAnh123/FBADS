# ===== MCP Telegram bridge (tiến trình "bridge") — copy thành .env.bridge rồi điền =====

# Cổng bridge nghe trên máy; Cloudflare Tunnel trỏ hostname bridge vào đây (không trỏ vào Agent)
BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1
# Tên miền công khai của bridge qua Cloudflare Tunnel, dùng cho setWebhook
BRIDGE_PUBLIC_URL=https://bridge.example.com

# --- Telegram (cùng bot token với Agent) ---
TG_BOT_TOKEN=
# 16–256 ký tự A-Z a-z 0-9 _ -  (Telegram gửi lại trong header X-Telegram-Bot-Api-Secret-Token)
TG_WEBHOOK_SECRET=
TG_ALLOWED_CHAT_IDS=
# Chat nhận tin từ Claude; mặc định = id đầu tiên trong TG_ALLOWED_CHAT_IDS
TG_OWNER_CHAT_ID=

# --- Claude custom connector ---
# ≥ 32 ký tự ngẫu nhiên; claude.ai gửi trong header Authorization: Bearer <MCP_TOKEN>
MCP_TOKEN=
# Đặt 1 nếu màn hình thêm connector không có mục "Request headers" (beta): dùng URL https://<bridge>/mcp/<MCP_TOKEN>
MCP_ALLOW_PATH_TOKEN=0

# --- Test local không cần tunnel ---
# 1 = bridge tự nhận tin bằng getUpdates thay webhook (tự gỡ webhook nếu có, bỏ qua setWebhook). Agent phải để TG_POLLING=0.
# Chạy thật qua Cloudflare Tunnel: đặt 0 rồi khởi động lại bridge.
BRIDGE_POLLING=0

# --- Ai xử lý brief #NEW / #ADD ---
# claude: bridge tự chạy `claude -p` (Claude Code đã đăng nhập claude.ai trên máy này), dùng connector
#         Facebook Ads / Shopify / Google Drive có sẵn → KHÔNG cần token Meta, Shopify, Google, Claude API trên server.
#         Không chạy tiến trình agent. Creative trên Drive phải để "Bất kỳ ai có đường liên kết – Người xem".
# agent:  chuyển brief sang Agent (cần đủ khoá trong .env.agent).
BRIEF_HANDLER=claude
# Đường dẫn đầy đủ tới claude.exe (pm2 / dịch vụ Windows có thể không thấy PATH của user)
CLAUDE_BIN=C:/Users/Admin/.local/bin/claude.exe
# Model / effort cho các lượt chạy; trống = mặc định của tài khoản (chạy --restricted nên settings.json của user không áp dụng)
CLAUDE_RUN_MODEL=
CLAUDE_RUN_EFFORT=
# Một lượt quá thời gian này thì bị dừng và báo /retry
CLAUDE_RUN_TIMEOUT_MIN=40
# Nơi lưu log từng lượt (prompt, stderr, kết quả JSON) — data/ không vào Git
CLAUDE_RUN_DIR=data/claude-runs
# 1 = chạy thử: lượt claude chỉ có tool ĐỌC (Shopify, Drive, Meta), tin duyệt gắn 🧪 CHẠY THỬ,
#     Duyệt / Huỷ chỉ giả lập — không tạo / sửa / bật gì trên Page hay tài khoản quảng cáo
CLAUDE_DRY_RUN=0
# Tài khoản H3 (mặc định đúng như Tab 1, chỉ điền khi đổi)
# META_AD_ACCOUNT=25496622559924808
# META_PAGE_ID=101065259399535
# META_PIXEL_ID=625569536048355
# Giới hạn an toàn (giống .env.agent)
LIMIT_BUDGET_CONFIRM_USD=300
LIMIT_TOTAL_BUDGET_USD=1500
LIMIT_CAP_MIN_USD=5
LIMIT_CAP_MAX_USD=150
LIMIT_MAX_FILES=10
DUPLICATE_WINDOW_MIN=10
APPROVAL_REMIND_AFTER_H=24
APPROVAL_AUTO_CANCEL_AFTER_H=72

# --- Agent trên localhost (chỉ dùng khi BRIEF_HANDLER=agent) ---
AGENT_PORT=8788
# Giống hệt BRIDGE_KEY trong .env.agent. Chế độ claude vẫn cần (dùng để ký nút duyệt).
BRIDGE_KEY=

# --- Giới hạn ---
BRIDGE_SEND_PER_MIN=30
AGENT_RETRY_EVERY_S=30
AGENT_NOTIFY_AFTER_MIN=10
AGENT_GIVE_UP_AFTER_H=24

BRIDGE_DB=data/bridge.db
LOG_LEVEL=info

# --- Media staging: chỉ đọc Drive, phục vụ link ngắn hạn cho Meta ---
# Đường dẫn JSON service account hoặc JSON một dòng; chỉ scope drive.readonly.
# Để trống = chỉ tải được file Drive đã mở Bất kỳ ai có đường liên kết.
DRIVE_SERVICE_ACCOUNT_JSON=
MEDIA_CACHE_DIR=data/staged-media
MEDIA_CACHE_MAX_BYTES=5000000000
# Đường dẫn ffprobe.exe trên máy chạy bridge (bắt buộc để đo metadata media).
FFPROBE_PATH=ffprobe

# --- Thanh toán H3: token System User chỉ ads_read, không dùng cho lệnh ghi ---
META_READ_TOKEN=
META_API_VERSION=v26.0
